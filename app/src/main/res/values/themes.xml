<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CostControl" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_ink</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/brand_wash</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="textInputStyle">@style/Widget.CC.TextInput</item>
        <item name="materialButtonStyle">@style/Widget.CC.Button</item>
    </style>

    <style name="Theme.CostControl.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.CostControl</item>
    </style>

    <style name="Widget.CC.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/brand_ink</item>
        <item name="hintTextColor">@color/brand_ink</item>
        <item name="startIconTint">@color/mute</item>
    </style>

    <style name="Widget.CC.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
